{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sahara-contact",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // Relay failures are only useful if someone can read them.
  "observability": { "enabled": true },

  // The binding only accepts a 10s or 60s period, so this is 3 per minute
  // rather than the 5 per 15 minutes the old server enforced in process.
  // namespace_id is an arbitrary but permanent id; changing it resets counters.
  "ratelimits": [
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],

  "vars": {
    "MAIL_FROM": "Sahara Software Website <website@saharasoftware.co.nz>",
    "CONTACT_TO": "info@saharasoftware.co.nz"
  }

  // RESEND_API_KEY is a secret, not a var:
  //   wrangler secret put RESEND_API_KEY
}
