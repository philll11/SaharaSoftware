---
// A stacked architecture picture in plain HTML, so it reflows and reads as
// text. Each layer holds one or more boxes side by side.
export interface Box {
  title: string;
  body: string;
  tone?: "accent" | "teal";
}

interface Props {
  layers: { label: string; boxes: Box[] }[];
  label: string;
}
const { layers, label } = Astro.props;
---

<div class="layers" role="group" aria-label={label}>
  {
    layers.map((layer) => (
      <div class="layer">
        <span class="layer-label">{layer.label}</span>
        <ul class="layer-boxes">
          {layer.boxes.map((b) => (
            <li class:list={["layer-box", b.tone && `tone-${b.tone}`]}>
              <b>{b.title}</b>
              <span>{b.body}</span>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>

