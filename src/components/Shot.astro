---
// A screenshot in a frame: a plain application window by default, or a drawn
// frame with corner marks (`drawn`), or none (`framed={false}`). With both a
// light and a dark capture, the one matching the site's theme shows.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  light: ImageMetadata;
  dark?: ImageMetadata | undefined;
  alt: string;
  title?: string | undefined;
  eager?: boolean;
  sizes?: string;
  framed?: boolean;
  drawn?: boolean;
}

const {
  light,
  dark,
  alt,
  title,
  eager = false,
  sizes = "(max-width: 1160px) 100vw, 1100px",
  framed = true,
  drawn = false,
} = Astro.props;
const loading = eager ? "eager" : "lazy";
const widths = [640, 960, 1280, 1920].filter((w) => w <= light.width);
const windowFrame = framed && !drawn;
---

<div class:list={[windowFrame && "frame", drawn && "drawn shot-drawn", "shot"]}>
  {
    windowFrame && (
      <div class="frame-bar" aria-hidden="true">
        <i />
        <i />
        <i />
        <span>{title}</span>
      </div>
    )
  }
  <Image src={light} alt={alt} widths={widths} sizes={sizes} loading={loading} class:list={[dark && "only-light"]} />
  {dark && <Image src={dark} alt={alt} widths={widths} sizes={sizes} loading={loading} class="only-dark" />}
</div>
