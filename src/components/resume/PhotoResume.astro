---
// The private resume with a photo, kept for sending directly and never
// published: only `pnpm resume` builds it. The photo header, navy sidebar and
// timeline come from Leonard's 2025 CV, in the Sahara palette. The markup reads
// header, main column, sidebar, so a parser meets the experience first.
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import photo from "../../assets/people/leonard-round.jpg";
import { certificateGroups, employers, monthYear, profileParagraphs, resume, type Employer } from "../../resume";

// Page 2 starts at this employer's highlight, part-way through a role as a
// flowing document would, so both pages run to the foot. The print script fails
// the build when a page overflows; move the split when the content outgrows it.
const PAGE_TWO = { employer: 1, highlight: 0 };

interface Part {
  employer: Employer;
  from: number;
  to?: number | undefined;
  continued?: boolean;
}

const pages: Part[][] = [
  [
    ...employers.slice(0, PAGE_TWO.employer).map((employer) => ({ employer, from: 0 })),
    { employer: employers[PAGE_TWO.employer]!, from: 0, to: PAGE_TWO.highlight },
  ],
  [
    { employer: employers[PAGE_TWO.employer]!, from: PAGE_TWO.highlight, continued: true },
    ...employers.slice(PAGE_TWO.employer + 1).map((employer) => ({ employer, from: 0 })),
  ],
];

const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
const { basics } = resume;
const [education] = resume.education;
const display = (url: string) => url.replace(/^https?:\/\/(www\.)?/, "");
const contact = [
  { label: "Email", value: basics.email, href: `mailto:${basics.email}` },
  { label: "Web", value: display(basics.url), href: basics.url },
  ...basics.profiles.map((p) => ({ label: p.network, value: display(p.url), href: p.url })),
];
const icons: Record<string, string> = {
  Email: "M3 6h18v12H3z M3 7l9 6 9-6",
  Web: "M12 3a9 9 0 1 0 0 18a9 9 0 1 0 0-18 M3 12h18 M12 3c3 3 3 15 0 18 M12 3c-3 3-3 15 0 18",
  LinkedIn: "M4 4h16v16H4z M8 11v5 M8 8v.01 M12 16v-5 M12 13a2 2 0 0 1 4 0v3",
  GitHub:
    "M9 19c-4 1.5-4-2-6-2.5 M15 21v-3.5a3 3 0 0 0-.9-2.4c3-.3 6-1.5 6-6.6a5.2 5.2 0 0 0-1.4-3.6 4.8 4.8 0 0 0-.1-3.6s-1.1-.3-3.6 1.4a12.4 12.4 0 0 0-6.5 0C6 1.4 4.9 1.7 4.9 1.7a4.8 4.8 0 0 0-.1 3.6A5.2 5.2 0 0 0 3.4 8.9c0 5.1 3 6.3 6 6.6a3 3 0 0 0-.9 2.4V21",
};
---

<div class="a">
  {
    pages.map((parts, pageIndex) => (
      <section class="sheet a-page" aria-label={`Page ${pageIndex + 1} of ${pages.length}`}>
        {pageIndex === 0 ? (
          <header class="a-head">
            <div class="a-photo">
              <Image src={photo} alt={basics.name} widths={[400, 720]} sizes="34mm" />
            </div>
            <div class="a-id">
              <h1>{basics.name}</h1>
              <p class="a-role">
                {basics.label} <span>· {basics.location.region}</span>
              </p>
              <p class="a-headline">{basics.custom.headline}</p>
              <ul class="a-contact">
                {contact.map((c) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d={icons[c.label]} />
                    </svg>
                    <a href={c.href}>{c.value}</a>
                  </li>
                ))}
              </ul>
            </div>
          </header>
        ) : (
          <header class="a-head a-head-slim">
            <p class="a-slim-name">{basics.name}</p>
            <p class="a-slim-role">{basics.label}</p>
          </header>
        )}

        <div class="a-main" data-fit>
          {pageIndex === 0 && (
            <>
              <h2 class="a-h2">Profile</h2>
              <div class="a-profile">
                {profileParagraphs.map((p) => (
                  <p>{p}</p>
                ))}
              </div>

              <h2 class="a-h2">Selected work</h2>
              <ul class="a-projects">
                {work.map((w) => (
                  <li>
                    <div class="a-project-line">
                      <h3>{w.data.name}</h3>
                      <span class="a-status">{w.data.status.label}</span>
                    </div>
                    <p>{w.data.resume.line}</p>
                    <p class="a-stack">{w.data.resume.stack.join(", ")}</p>
                  </li>
                ))}
              </ul>
            </>
          )}

          <h2 class="a-h2">{pageIndex === 0 ? "Work experience" : "Work experience, continued"}</h2>
          {parts.map(({ employer, from, to, continued }) => (
            <div class="a-job">
              {!employer.isBreak && !continued && <p class="a-org">{employer.name}</p>}
              {employer.roles.map((r) => {
                const highlights = r.resumeHighlights.slice(from, to);
                return (
                  <div class:list={["a-role-block", { "a-continued": continued }]}>
                    {!continued && (
                      <>
                        <h3 class="a-role-title">{r.title}</h3>
                        <div class="a-role-meta">
                          <span>{employer.location}</span>
                          <span>
                            {monthYear(r.start, true)} - {r.end ? monthYear(r.end, true) : "Present"}
                          </span>
                        </div>
                      </>
                    )}
                    <div class="a-role-body">
                      {r.resumeSummary && !continued && <p>{r.resumeSummary}</p>}
                      {highlights.length > 0 && (
                        <ul class="a-points">
                          {highlights.map((h) => (
                            <li>{h}</li>
                          ))}
                        </ul>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          ))}
        </div>

        <aside class="a-side" data-fit>
          {pageIndex === 0 ? (
            <>
              <h2 class="a-side-h2">Certifications</h2>
              {certificateGroups.map((g) => (
                <div class="a-side-group">
                  <h3>{g.issuer}</h3>
                  <ul>
                    {g.items.map((c) => (
                      <li>
                        {c.name}
                        {c.date && <span class="a-year"> {c.date.slice(0, 4)}</span>}
                      </li>
                    ))}
                  </ul>
                </div>
              ))}

              <h2 class="a-side-h2">Education</h2>
              <div class="a-side-group">
                <h3>{education!.studyType}</h3>
                <p>{education!.custom.detail}</p>
                <p class="a-school">
                  {education!.institution}, {education!.location}
                </p>
              </div>

              <h2 class="a-side-h2">Availability</h2>
              <p>{basics.custom.availability}</p>
            </>
          ) : (
            <>
              <h2 class="a-side-h2">Core skills</h2>
              {resume.skills.map((s) => (
                <div class="a-side-group">
                  <h3>{s.name}</h3>
                  <ul>
                    {s.keywords.map((k) => (
                      <li>{k}</li>
                    ))}
                  </ul>
                </div>
              ))}
            </>
          )}
          <p class="a-page-no" data-foot>
            Page {pageIndex + 1} of {pages.length}
          </p>
        </aside>
      </section>
    ))
  }
</div>

<style>
  .a {
    --a-navy: #13324e;
    --a-tint: #e4eef3;
    --a-ink: #13324e;
    --a-body: #3f4f60;
    --a-muted: #5d6b79;
    --a-accent: #a8541a;
    --a-rule: #c9d6de;
    --a-side-text: #dbe6ee;
    --a-side-muted: #9fb6c8;
    font-family: var(--font-raleway);
    color: var(--a-body);
    font-size: 8.4pt;
    line-height: 1.38;
    font-variant-numeric: lining-nums;
  }

  .a-page {
    display: grid;
    grid-template-columns: 66mm minmax(0, 1fr);
    grid-template-rows: auto minmax(0, 1fr);
    grid-template-areas:
      "head head"
      "side main";
  }

  /* ---------------------------------------------------------------- header */

  .a-head {
    grid-area: head;
    display: grid;
    grid-template-columns: 66mm minmax(0, 1fr);
    align-items: center;
    height: 46mm;
    background: var(--a-tint);
  }

  .a-photo {
    justify-self: center;
    width: 34mm;
    height: 34mm;
    border: 1.2mm solid #fff;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0.6mm 2mm rgba(14, 36, 56, 0.25);
  }

  .a-photo :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .a-id {
    padding: 0 12mm 0 8mm;
  }

  .a-id h1 {
    color: var(--a-ink);
    font-size: 29pt;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .a-role {
    margin-top: 1.6mm;
    color: var(--a-ink);
    font-size: 11pt;
    font-weight: 700;
  }

  .a-role span {
    color: var(--a-muted);
    font-weight: 600;
  }

  .a-headline {
    margin-top: 0.8mm;
    color: var(--a-muted);
    font-size: 8pt;
    font-weight: 500;
  }

  .a-contact {
    display: grid;
    grid-template-columns: max-content max-content;
    gap: 1.2mm 7mm;
    margin-top: 3mm;
    padding: 0;
    list-style: none;
    color: var(--a-ink);
    font-size: 7.8pt;
    font-weight: 600;
  }

  .a-contact li {
    display: flex;
    align-items: center;
    gap: 1.8mm;
  }

  .a-contact svg {
    flex: none;
    width: 3.4mm;
    height: 3.4mm;
    fill: none;
    stroke: var(--a-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .a-head-slim {
    display: flex;
    align-items: center;
    gap: 4mm;
    height: 13mm;
    padding-left: 74mm;
  }

  .a-slim-name {
    color: var(--a-ink);
    font-size: 14pt;
    font-weight: 800;
  }

  .a-slim-role {
    color: var(--a-muted);
    font-size: 9pt;
    font-weight: 600;
  }

  /* ----------------------------------------------------------- main column */

  .a-main {
    grid-area: main;
    padding: 7mm 12mm 10mm 8mm;
  }

  .a-h2 {
    margin: 0 0 3mm;
    padding-bottom: 1.4mm;
    border-bottom: 0.35mm solid var(--a-navy);
    color: var(--a-ink);
    font-size: 12pt;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .a-h2:not(:first-child) {
    margin-top: 5mm;
  }

  .a-profile p + p {
    margin-top: 1.6mm;
  }

  .a-projects {
    padding: 0;
    list-style: none;
  }

  .a-projects li + li {
    margin-top: 2.2mm;
  }

  /* A status too long to share the name's line moves whole onto the next one. */
  .a-project-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0 3mm;
  }

  .a-project-line h3 {
    color: var(--a-ink);
    font-size: 9.6pt;
    font-weight: 800;
  }

  .a-status {
    margin-left: auto;
    color: var(--a-accent);
    font-size: 7.6pt;
    font-weight: 700;
    white-space: nowrap;
  }

  .a-stack {
    margin-top: 0.4mm;
    color: var(--a-muted);
    font-size: 7.6pt;
    font-weight: 600;
  }

  .a-job + .a-job {
    margin-top: 4mm;
  }

  /* Wider letter-spacing makes PDF text extractors split the name into letters. */
  .a-org {
    margin-bottom: 1.4mm;
    color: var(--a-ink);
    font-size: 9pt;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .a-role-block {
    padding-left: 4.5mm;
  }

  .a-role-block + .a-role-block {
    margin-top: 3mm;
  }

  .a-role-title {
    color: var(--a-ink);
    font-size: 9.8pt;
    font-weight: 800;
    letter-spacing: 0.02em;
  }

  .a-role-title::before {
    content: "";
    display: inline-block;
    width: 2.4mm;
    height: 2.4mm;
    margin: 0 2.1mm 0 -4.5mm;
    border-radius: 50%;
    background: var(--a-accent);
  }

  .a-role-meta {
    display: flex;
    justify-content: space-between;
    color: var(--a-muted);
    font-size: 7.8pt;
    font-weight: 600;
  }

  .a-role-body {
    margin: 1.4mm 0 0 -3.3mm;
    padding-left: 3.3mm;
    border-left: 0.35mm solid var(--a-rule);
  }

  .a-continued .a-role-body {
    margin-top: 0;
  }

  .a-points {
    margin-top: 1mm;
    padding-left: 3.6mm;
  }

  .a-continued .a-points {
    margin-top: 0;
  }

  .a-points li + li {
    margin-top: 0.7mm;
  }

  .a-points li::marker {
    color: var(--a-accent);
  }

  /* --------------------------------------------------------------- sidebar */

  .a-side {
    grid-area: side;
    display: flex;
    flex-direction: column;
    padding: 7mm 7mm 7mm 9mm;
    background: var(--a-navy);
    color: var(--a-side-text);
  }

  .a-side-h2 {
    margin: 0 0 2.6mm;
    color: #fff;
    font-size: 11.5pt;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .a-side-h2:not(:first-child) {
    margin-top: 6mm;
  }

  .a-side-group + .a-side-group {
    margin-top: 2.6mm;
  }

  .a-side-group h3 {
    margin-bottom: 0.6mm;
    color: #fff;
    font-size: 8.6pt;
    font-weight: 800;
  }

  .a-side-group ul {
    padding-left: 3.4mm;
  }

  .a-side-group li::marker {
    color: var(--a-side-muted);
  }

  .a-year {
    color: var(--a-side-muted);
  }

  .a-school {
    margin-top: 0.6mm;
    color: #fff;
    font-weight: 700;
  }

  .a-page-no {
    margin-top: auto;
    padding-top: 4mm;
    color: var(--a-side-muted);
    font-size: 7pt;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
</style>
