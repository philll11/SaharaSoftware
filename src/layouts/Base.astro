---
import { createHash } from "node:crypto";
import { Font } from "astro:assets";
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { BUSINESS, SITE_URL } from "../config";
// Runs before first paint so a saved theme never flashes the other one.
import themeInit from "../scripts/theme-init.js?raw";

interface Props {
  title: string;
  description: string;
  /** Path of the page's share image under public/, such as "/og/home.png". */
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  current?: "work" | "services" | "method" | "experience";
}

const { title, description, ogImage = "/og/home.png", jsonLd, current } = Astro.props;

const path = Astro.url.pathname.replace(/\.html$/, "").replace(/\/index$/, "/");
const canonical = new URL(path === "" ? "/" : path, SITE_URL).href;

// An inline script needs its hash in the policy; Astro hashes only the
// scripts it bundles, so this one is hashed here from the exact bytes sent.
Astro.csp?.insertScriptHash(`sha256-${createHash("sha256").update(themeInit).digest("base64")}`);
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#F7F0E1" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0E2438" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={BUSINESS} />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, SITE_URL).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline set:html={themeInit} />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
