---
// An A4 document for printing to PDF, with the site's fonts and policy and no
// site header or footer. Each `.sheet` is one printed page. On screen the
// sheets sit on a grey desk, so a page can be checked in a browser first.
// No box on a sheet is positioned: Chromium writes positioned boxes to the PDF
// after the rest of the page, which breaks the reading order a parser extracts.
import { Font } from "astro:assets";
import type { ComponentProps } from "astro/types";

interface Props {
  title: string;
  /** The photo design's typeface; the private build alone carries it. */
  raleway?: boolean;
}

const { title, raleway = false } = Astro.props;

// Raleway is configured only in the private build (astro.config.ts), so the
// font types, generated from the public configuration, do not list it.
const RALEWAY = "--font-raleway" as ComponentProps<typeof Font>["cssVariable"];
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <Font cssVariable="--font-display" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />
    {raleway && <Font cssVariable={RALEWAY} />}
  </head>
  <body class="print-desk">
    <slot />
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .print-desk {
    padding: 24px 0;
    background: #5c6168;
  }

  .sheet {
    width: 210mm;
    height: 297mm;
    margin: 0 auto 24px;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
  }

  /* Zero specificity, so each design's own spacing wins. */
  :where(.sheet) :where(p, h1, h2, h3, ul, ol, dl, dd) {
    margin: 0;
  }

  :where(.sheet) a {
    color: inherit;
    text-decoration: none;
  }

  @media print {
    .print-desk {
      padding: 0;
      background: none;
    }

    .sheet {
      margin: 0;
      box-shadow: none;
      break-after: page;
    }

    .sheet:last-child {
      break-after: auto;
    }
  }
</style>
