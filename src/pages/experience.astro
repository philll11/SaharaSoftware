---
import Base from "../layouts/Base.astro";
import { CV_URL, EMAIL, GITHUB_URL, LINKEDIN_URL } from "../config";

interface Role {
  title: string;
  when: string;
  points: string[];
}
interface Job {
  org: string;
  where: string;
  when: string;
  title?: string;
  summary?: string;
  points?: string[];
  roles?: Role[];
}

const jobs: Job[] = [
  {
    org: "Sahara Software",
    title: "Sole trader, AI and integration engineer",
    when: "June 2026 to present",
    where: "New Zealand, remote",
    summary:
      "My own business, for clients in New Zealand and Australia. On contract to a large European construction company, working remotely from New Zealand. Across this engagement and my earlier secondment there, with LLMs doing much of the coding and my own design, checks and approval around it:",
    points: [
      "Built Testify, an automated regression testing platform for Boomi, live in production.",
      "Built Fathom, a plugin for Claude Code and GitHub Copilot CLI, with its own skills, hooks and toolchain, that lets AI agents build Boomi integrations safely. The client's integration developers use it for their integration work.",
      "Designed a monitoring platform for Boomi in the client's own Azure, on OpenTelemetry and Grafana and defined entirely as code, in development and validated end to end in a sandbox.",
      "Built agent-dashboard, an open-source dashboard for the usage, cost and plan limits of Claude Code and GitHub Copilot.",
    ],
  },
  {
    org: "Emixa",
    title: "Integration Consultant",
    when: "October 2023 to May 2026",
    where: "Netherlands",
    summary:
      "Seconded to a large European construction company from January 2024, working with Boomi, Solace, Azure API Management, Salesforce and ServiceNow.",
    points: [
      "Designed a RESTful API in Azure API Management that gave third-party applications controlled access to residential construction data that security policy barred them from reaching directly.",
      "Designed an event-driven integration that carries ServiceNow changes to three other systems, with a routing layer that mimics Solace, so only that layer changes when Solace goes live.",
      "Became lead maintainer of the open-source Solace Queue Message Viewer, a Solace-managed repository, and demoed it as a guest speaker at the Solace Community lightning talks in January 2025.",
    ],
  },
  {
    org: "Career break",
    when: "June 2023 to September 2023",
    where: "Europe",
    summary: "Travelled Europe in a van called Vincent.",
  },
  {
    org: "Datacom",
    when: "September 2021 to June 2023",
    where: "Auckland, New Zealand",
    roles: [
      {
        title: "Principal Engineer, ERP and Integration",
        when: "October 2022 to June 2023",
        points: [
          "Technical lead on implementation and customisation projects across the business, including Peppol e-invoicing for accounts payable and receivable, an Oracle Fusion HCM implementation, and a custom memorised-transaction solution for a new productised service.",
        ],
      },
      {
        title: "Senior Engineer, ERP and Integration",
        when: "September 2021 to September 2022",
        points: [
          "Connected Datacom's internal business systems with Boomi, customising NetSuite where an integration met its limits.",
        ],
      },
    ],
  },
  {
    org: "Archant",
    title: "NetSuite Developer and Administrator",
    when: "January 2021 to September 2021",
    where: "Hawke's Bay, New Zealand",
    points: [
      "Built the shipping integration that connects NetSuite order fulfilment to Mainfreight's distribution platform.",
      "Project-managed a Magento 2 e-commerce deployment integrated with NetSuite.",
      "Built a purchase order and expense approval workflow with delegated financial authority limits and a multi-level hierarchy.",
      "Implemented inbound shipments for more accurate arrival dates and cash-flow forecasting.",
    ],
  },
  {
    org: "Datacom",
    title: "NetSuite Technical Analyst",
    when: "October 2019 to January 2021",
    where: "Auckland, New Zealand",
    points: ["Diagnosed NetSuite issues and turned stakeholder requirements and business constraints into solutions."],
  },
];

const certifications = [
  { name: "Solutions Architect", issuer: "Solace", when: "October 2023" },
  { name: "Event Driven Architecture Practitioner", issuer: "Solace", when: "October 2023" },
  { name: "Professional API Design", issuer: "Boomi", when: "October 2023" },
  { name: "Professional API Management", issuer: "Boomi", when: "October 2023" },
  { name: "Associate Master Data Hub", issuer: "Boomi", when: "October 2023" },
  { name: "Associate Administrator", issuer: "Boomi", when: "January 2022" },
  { name: "SuiteAnalytics User", issuer: "NetSuite", when: "April 2022" },
  { name: "SuiteCloud Developer II", issuer: "NetSuite", when: "December 2021" },
  { name: "Certified Administrator", issuer: "NetSuite", when: "November 2021" },
  { name: "Professional Scrum Master I", issuer: "Scrum.org", when: "September 2025" },
];

const skills = [
  { group: "Building with AI", items: ["Claude Code", "GitHub Copilot", "Agent plugins and skills", "Hooks and subagents", "MCP servers", "Generative AI"] },
  {
    group: "Integration",
    items: ["Boomi", "NetSuite", "Solace", "Event-driven architecture", "REST and SOAP APIs", "Azure API Management"],
  },
  { group: "Languages and frameworks", items: ["TypeScript", "React", "NestJS", "Go", "Rust", "JavaScript", "PostgreSQL"] },
  {
    group: "Cloud and delivery",
    items: ["Microsoft Azure", "Bicep", "Docker", "Kubernetes", "OpenTelemetry", "Grafana", "Azure DevOps", "GitHub Actions", "Test automation"],
  },
];
---

<Base
  title="Experience | Leonard Phillips, AI and integration engineer"
  description="Leonard Phillips' career: seven years in business systems and integration at Datacom, Archant and Emixa, and AI-built platforms for Boomi as a sole trader. Certifications and skills."
  current="experience"
>
  <section class="page-head">
    <div class="container page-head-inner">
      <p class="eyebrow">Experience</p>
      <h1>Seven years of joining up the systems businesses run on</h1>
      <p class="lead">
        NetSuite development in New Zealand, integration consulting in the Netherlands, and AI-built platforms for Boomi
        as a sole trader.
      </p>
      <div class="availability">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.6 2.6L16.5 9.5"></path></svg>
        <p>
          Open to contract and permanent roles in AI and integration engineering, remote from New Zealand.{" "}
          {CV_URL ? <a href={CV_URL}>Download my CV (PDF)</a> : <a href={LINKEDIN_URL}>See my LinkedIn profile</a>}{" "}
          or email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
        </p>
      </div>
    </div>
    <svg class="dunes" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="dune-1" d="M0,70 C260,30 520,96 760,78 C1000,60 1200,30 1440,58 L1440,120 L0,120 Z"></path>
      <path class="dune-3" d="M0,120 C300,92 640,114 920,104 C1160,96 1340,100 1440,108 L1440,120 Z"></path>
    </svg>
  </section>

  <section class="section" aria-labelledby="career-title">
    <div class="container">
      <h2 id="career-title" class="visually-hidden">Career</h2>
      <ol class="timeline">
        {
          jobs.map((job) => (
            <li>
              <div class="tl-when">
                {job.when}
                <br />
                {job.where}
              </div>
              <div class="tl-what">
                <h3>{job.title ?? job.org}</h3>
                {job.title && <span class="tl-org">{job.org}</span>}
                {job.summary && <p>{job.summary}</p>}
                {job.points && (
                  <ul>
                    {job.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                )}
                {job.roles && (
                  <ul class="tl-roles">
                    {job.roles.map((r) => (
                      <li>
                        <b>{r.title}</b>
                        <span>{r.when}</span>
                        {r.points.map((p) => (
                          <p>{p}</p>
                        ))}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="certs-title">
    <div class="container">
      <div class="section-head">
        <h2 id="certs-title">Certifications</h2>
      </div>
      <ul class="cert-grid">
        {
          certifications.map((c) => (
            <li>
              <b>{c.name}</b>
              <span>
                {c.issuer} · {c.when}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-head">
        <h2 id="skills-title">Skills</h2>
      </div>
      <div class="skill-groups">
        {
          skills.map((s) => (
            <div>
              <h3>{s.group}</h3>
              <ul class="chips">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="experience-links">
        <a class="link-arrow" href="/#work">See the case studies</a>
        <a class="link-arrow" href={LINKEDIN_URL}>LinkedIn</a>
        <a class="link-arrow" href={GITHUB_URL}>GitHub</a>
      </p>
    </div>
  </section>
</Base>
