---
import Base from "../layouts/Base.astro";
import { EMAIL, GITHUB_URL, LINKEDIN_URL, RESUME_URL } from "../config";
import { dateRange, employers, monthYear, resume } from "../resume";

interface Role {
  title: string;
  when: string;
  points: string[];
}
interface Job {
  org: string;
  where: string;
  when: string;
  title?: string | undefined;
  summary?: string | undefined;
  points?: string[] | undefined;
  roles?: Role[];
}

// An employer with one role shows it in place of the employer's name; one with
// several lists each role under the employer.
const jobs: Job[] = employers.map((e) => {
  const when = dateRange(e.start, e.end);
  if (e.roles.length > 1) {
    return {
      org: e.name,
      where: e.location,
      when,
      roles: e.roles.map((r) => ({ title: r.title, when: dateRange(r.start, r.end), points: r.highlights })),
    };
  }
  const [role] = e.roles;
  return {
    org: e.name,
    where: e.location,
    when,
    title: e.isBreak ? undefined : role!.title,
    summary: role!.summary,
    points: role!.highlights.length ? role!.highlights : undefined,
  };
});

const certifications = resume.certificates.map((c) => ({
  name: c.name,
  issuer: c.issuer,
  when: c.date ? monthYear(c.date) : undefined,
}));

const [education] = resume.education;

const skills = resume.skills.map((s) => ({ group: s.name, items: s.keywords }));
---

<Base
  title="Experience | Leonard Phillips, AI and integration engineer"
  description="Leonard Phillips' career: seven years in business systems and integration at Datacom, Archant and Emixa, and AI-built platforms for Boomi as a sole trader. Certifications and skills."
  current="experience"
>
  <section class="page-head">
    <div class="container page-head-inner">
      <p class="eyebrow">Experience</p>
      <h1>Seven years of joining up the systems businesses run on</h1>
      <p class="lead">
        NetSuite development in New Zealand, integration consulting in the Netherlands, and AI-built platforms for Boomi
        as a sole trader.
      </p>
      <div class="availability">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M8 12.5l2.6 2.6L16.5 9.5"></path></svg>
        <p>
          {resume.basics.custom.availability}{" "}
          <a href={RESUME_URL}>Download my resume (PDF)</a> or email <a href={`mailto:${EMAIL}`}>{EMAIL}</a>.
        </p>
      </div>
    </div>
    <svg class="dunes" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="dune-1" d="M0,70 C260,30 520,96 760,78 C1000,60 1200,30 1440,58 L1440,120 L0,120 Z"></path>
      <path class="dune-3" d="M0,120 C300,92 640,114 920,104 C1160,96 1340,100 1440,108 L1440,120 Z"></path>
    </svg>
  </section>

  <section class="section" aria-labelledby="career-title">
    <div class="container">
      <h2 id="career-title" class="visually-hidden">Career</h2>
      <ol class="timeline">
        {
          jobs.map((job) => (
            <li>
              <div class="tl-when">
                {job.when}
                <br />
                {job.where}
              </div>
              <div class="tl-what">
                <h3>{job.title ?? job.org}</h3>
                {job.title && <span class="tl-org">{job.org}</span>}
                {job.summary && <p>{job.summary}</p>}
                {job.points && (
                  <ul>
                    {job.points.map((p) => (
                      <li>{p}</li>
                    ))}
                  </ul>
                )}
                {job.roles && (
                  <ul class="tl-roles">
                    {job.roles.map((r) => (
                      <li>
                        <b>{r.title}</b>
                        <span>{r.when}</span>
                        {r.points.map((p) => (
                          <p>{p}</p>
                        ))}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="certs-title">
    <div class="container">
      <div class="section-head">
        <h2 id="certs-title">Certifications</h2>
      </div>
      <ul class="cert-grid">
        {
          certifications.map((c) => (
            <li>
              <b>{c.name}</b>
              <span>{c.when ? `${c.issuer} · ${c.when}` : c.issuer}</span>
            </li>
          ))
        }
      </ul>
      <div class="section-head education-head">
        <h2 id="education-title">Education</h2>
      </div>
      <div class="education">
        <b>{education!.studyType}</b>
        <span>{education!.custom.detail}. {education!.institution}, {education!.location}.</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="skills-title">
    <div class="container">
      <div class="section-head">
        <h2 id="skills-title">Skills</h2>
      </div>
      <div class="skill-groups">
        {
          skills.map((s) => (
            <div>
              <h3>{s.group}</h3>
              <ul class="chips">
                {s.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
      <p class="experience-links">
        <a class="link-arrow" href="/#work">See the case studies</a>
        <a class="link-arrow" href={LINKEDIN_URL}>LinkedIn</a>
        <a class="link-arrow" href={GITHUB_URL}>GitHub</a>
      </p>
    </div>
  </section>
</Base>
