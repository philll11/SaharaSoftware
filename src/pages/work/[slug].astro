---
import { getCollection, render, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import Shot from "../../components/Shot.astro";

export async function getStaticPaths() {
  const work = (await getCollection("work")).sort((a, b) => a.data.order - b.data.order);
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, next: work[(i + 1) % work.length]! },
  }));
}

interface Props {
  entry: CollectionEntry<"work">;
  next: CollectionEntry<"work">;
}

const { entry, next } = Astro.props;
const { name, title, summary, description, status, role, stack, links, shot, og } = entry.data;
const { Content } = await render(entry);

const asOf = status.asOf.toLocaleDateString("en-NZ", { day: "numeric", month: "long", year: "numeric", timeZone: "Pacific/Auckland" });
---

<Base title={`${name}: ${title} | Leonard Phillips`} description={description} ogImage={og} current="work">
  <section class="page-head">
    <div class="container page-head-inner">
      <p class="breadcrumb apparatus"><a href="/#work">Work</a><span aria-hidden="true">/</span>{name}</p>
      <div class="case-intro">
        <div class="case-intro-copy">
          <p class="eyebrow">{name}</p>
          <h1>{title}</h1>
          <p class="lead">{summary}</p>
        </div>
        <dl class="titleblock" aria-label={`${name} at a glance`}>
          <div>
            <dt>Checked</dt>
            <dd><time datetime={status.asOf.toISOString().slice(0, 10)}>{asOf}</time></dd>
          </div>
          <div>
            <dt>Status</dt>
            <dd class:list={[status.live ? "status-live" : "status-open"]}>{status.label}</dd>
          </div>
          <div>
            <dt>My role</dt>
            <dd>{role}</dd>
          </div>
          <div>
            <dt>Built with</dt>
            <dd>{stack.join(" · ")}</dd>
          </div>
          {
            links.length > 0 && (
              <div>
                <dt>Links</dt>
                <dd>
                  <ul class="titleblock-links">
                    {links.map((l) => (
                      <li>
                        <a href={l.href}>{l.label}</a>
                      </li>
                    ))}
                  </ul>
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </div>
    <svg class="dunes" viewBox="0 0 1440 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="dune-1" d="M0,70 C260,30 520,96 760,78 C1000,60 1200,30 1440,58 L1440,120 L0,120 Z"></path>
      <path class="dune-3" d="M0,120 C300,92 640,114 920,104 C1160,96 1340,100 1440,108 L1440,120 Z"></path>
    </svg>
  </section>

  <section class="section case-section">
    <div class="container">
      {
        shot && (
          <figure class="fig case-fig">
            <Shot light={shot.light} dark={shot.dark} alt={shot.alt} drawn eager />
            <figcaption class="fig-caption">
              <span class="apparatus">Fig. 1</span>
              <span>{shot.title ?? name}</span>
            </figcaption>
          </figure>
        )
      }
      <div class="case-layout">
        <article class:list={["prose", "case-prose", shot && "has-fig"]}>
          <Content />
        </article>
        <aside class="case-next" aria-label="Next case study">
          <p class="apparatus">Next case study</p>
          <a class="case-next-link" href={`/work/${next.id}`}>
            <span>{next.data.name}</span>
            {next.data.title}
          </a>
          <a class="btn btn-primary" href="/#contact">Get in touch</a>
        </aside>
      </div>
    </div>
  </section>
</Base>
